{
  // Sborka: latexmk sam prozene pdflatex -> biber -> pdflatex tolikrat,
  // kolik je potreba pro vyreseni odkazu. Bibliografie pouziva biber,
  // nikoli bibtex -- recept s bibtexem by ji rozbil.
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "%DOC%"
      ],
      "env": {}
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (pdflatex + biber)",
      "tools": ["latexmk"]
    }
  ],

  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.view.pdf.viewer": "tab",

  "latex-workshop.latex.clean.fileTypes": [
    "*.aux", "*.bbl", "*.bcf", "*.blg", "*.fdb_latexmk", "*.fls",
    "*.lof", "*.lot", "*.out", "*.run.xml", "*.synctex.gz", "*.toc"
  ],

  "files.encoding": "utf8",
  "[latex]": {
    "editor.wordWrap": "on",
    "editor.tabSize": 2
  }
}
