# Собранный PDF и архивы.
# НЕ ставить сюда общее правило *.pdf: шаблону нужны исходные PDF —
# логотип факультета Figures/FEI_CZ.pdf и задание, которое diploma.cls
# вшивает через \includepdf. Без них работа не собирается.
BachelorThesis.pdf
*.zip

# Генерируется пакетом pdfx при каждой сборке — в репозитории не нужен
pdfa.xmpi

# IDE settings: сами настройки сборки держим в репозитории,
# чтобы latexmk-рецепт был одинаковый на Acer и на Huawei.
# Остальное содержимое .vscode/ (кэши, история) — мимо.
.vscode/*
!.vscode/settings.json
